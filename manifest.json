{
  "manifest_version": 3,
  "name": "Quiet Tab",
  "version": "2.0.0",
  "description": "A minimal, curated New Tab page that follows your Linux wallpaper and matugen colours, or any colour you pick.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
