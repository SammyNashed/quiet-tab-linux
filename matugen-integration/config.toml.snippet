# Add these entries to your own ~/.config/matugen/config.toml.
# Adjust paths if you cloned this repo somewhere other than ~/newtab.

[templates.quiet_tab]
input_path  = '~/newtab/matugen-integration/newtab-colors.json.template'
output_path = '~/newtab/colors.json'

[templates.helium_accent]
input_path  = '/dev/null'
output_path = '/dev/null'
post_hook   = '''
  python3 "$HOME/newtab/matugen-integration/set_helium_accent.py" "{{colors.primary.default.hex}}" || :
'''
